    <string name="about_desc">Exporta tus conversaciones de SMS a JSON, CSV, TXT o XML. Elige qué campos del mensaje incluir y ponle tú el nombre a cada label.</string>
    <string name="about_privacy_title">Privacidad</string>
    <string name="about_privacy">Tus mensajes se quedan en tu dispositivo y nunca se suben a ningún sitio. La app solo se conecta a internet cuando tocas «Buscar actualizaciones», para preguntarle a GitHub si hay una versión nueva.</string>
    <string name="about_perms_title">Permisos</string>
    <string name="about_perms">SMS: necesario para leer tus mensajes.\nContactos (opcional): solo se usa para mostrar el nombre del contacto en lugar del número.\nInternet: solo se usa cuando tocas «Buscar actualizaciones», nunca para acceder a tus mensajes.</string>
    <string name="about_files_title">¿Dónde están mis archivos?</string>
    <string name="about_files">Las exportaciones se guardan en Descargas/SMS Export.</string>
    <string name="about_limits_title">Limitaciones</string>
    <string name="about_limits">Solo se exportan SMS. Los MMS y las conversaciones de grupo no se incluyen.</string>
    <string name="check_updates">Buscar actualizaciones</string>
